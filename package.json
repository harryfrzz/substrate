{
  "name": "substrate",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts",
    "test": "bun test",
    "deploy:infra": "cd infra && bunx cdk deploy --all",
    "deploy:control": "bun scripts/deploy-control.ts",
    "deploy:host": "bun scripts/deploy-host.ts",
    "images:build": "bun scripts/build-images.ts",
    "setup:host": "bun scripts/setup-host.ts",
    "host": "bun scripts/host.ts",
    "ssm": "bun scripts/ssm.ts",
    "logs": "bun scripts/logs.ts",
    "vm": "bun scripts/vm.ts",
    "check:m0": "bun scripts/check-m0.ts",
    "check:m1": "bun scripts/check-m1.ts",
    "check:m3": "bun scripts/check-m3.ts",
    "check:m6": "bun scripts/check-m6.ts",
    "generate:firecracker": "bun scripts/generate-firecracker.ts",
    "github:token": "bun scripts/github-token.ts",
    "secrets": "bun scripts/secrets.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-budgets": "^3.1156.0",
    "@aws-sdk/client-cloudformation": "^3.1156.0",
    "@aws-sdk/client-ec2": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-ssm": "^3.1156.0",
    "@aws-sdk/client-sts": "^3.1156.0",
    "@substrate/protocol": "workspace:*",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
